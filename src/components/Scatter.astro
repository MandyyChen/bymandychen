---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { placements, threadPath } from '../lib/scatter';

interface Props {
	seed: string;
	photos: ImageMetadata[];
}

const { seed, photos } = Astro.props;
const pos = placements(seed, photos.length);

// Canvas grows with the number of photos so nothing gets cramped.
const H = Math.max(620, photos.length * 185);
const pts = pos.map((p) => ({ x: p.x * 100, y: p.y * H }));
const d = threadPath(pts);
---

<div class="scatter" style={`--h:${H}px`}>
	<svg
		class="thread"
		viewBox={`0 0 100 ${H}`}
		preserveAspectRatio="none"
		aria-hidden="true"
	>
		<path
			d={d}
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
			vector-effect="non-scaling-stroke"
		></path>
	</svg>

	{
		photos.map((img, i) => (
			<figure
				class="pic"
				style={`--x:${pos[i].x};--y:${pos[i].y};--w:${pos[i].w}px;--rot:${pos[i].rot}deg`}
			>
				<Image src={img} alt="" width={460} />
				<span class="n">{i + 1}</span>
			</figure>
		))
	}
</div>

<style>
	.scatter {
		position: relative;
		width: 100%;
		height: var(--h);
		margin: 0.5rem 0 1rem;
		color: #111;
	}

	.thread {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		opacity: 0.85;
	}

	.pic {
		position: absolute;
		left: calc(var(--x) * 100%);
		top: calc(var(--y) * 100%);
		width: var(--w);
		margin: 0;
		padding: 5px;
		background: #fff;
		border: 1px solid rgba(0, 0, 0, 0.1);
		box-shadow: 0 10px 22px -14px rgba(0, 0, 0, 0.55);
		transform: translate(-50%, -50%) rotate(var(--rot));
	}

	.pic :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.n {
		position: absolute;
		top: -11px;
		left: -11px;
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: #111;
		color: #fff;
		font: 600 11px/1 var(--mono);
	}

	@media (max-width: 760px) {
		.scatter {
			height: auto;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1.6rem;
		}
		.thread {
			display: none;
		}
		.pic {
			position: static;
			width: min(340px, 100%);
			transform: rotate(var(--rot));
		}
	}
</style>
