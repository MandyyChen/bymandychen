---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title?: string;
	description?: string;
	bleed?: boolean;
}

const { title, description = SITE_DESCRIPTION, bleed = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={fullTitle} description={description} />
	</head>
	<body>
		{bleed ? <slot /> : <main><slot /></main>}
	</body>
</html>
