---
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';

const PORTFOLIO_URL = 'https://mandyychen.com';
const CATEGORIES = ['hardware for people', 'visual thinking', 'computer vision', 'thoughts', 'memo'];
const CLICKABLE = new Set(['hardware for people', 'memo']);
const catId = (c: string) => 'cat-' + c.replace(/\s+/g, '-').toLowerCase();

// a folder can show a fixed note instead of an entry list
const FOLDER_TEXT: Record<string, string> = {
	memo: 'welcome to one of my internet homes, happy to have you here! i created this to document my learnings and experiment with hyperlinks on the infinite web.',
};

const entries = (await getCollection('diary')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const files = import.meta.glob<{ default: ImageMetadata }>(
	'/src/content/diary/*/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}',
	{ eager: true },
);
const photosFor = (id: string) =>
	Object.keys(files)
		.filter((k) => k.startsWith(`/src/content/diary/${id}/`))
		.sort()
		.map((k) => files[k].default);

const rendered = await Promise.all(
	entries.map(async (e) => ({
		e,
		Content: (await render(e)).Content,
		photos: photosFor(e.id),
	})),
);

// group entries into their category "folders"
const used = new Set<string>();
const folders = CATEGORIES.map((c) => {
	const list = rendered.filter(
		({ e }) => (e.data.category ?? '').toLowerCase() === c.toLowerCase(),
	);
	list.forEach(({ e }) => used.add(e.id));
	return { c, id: catId(c), list };
});
const misc = rendered.filter(({ e }) => !used.has(e.id));
---

<Page bleed>
	<div class="views">
		<!-- HOME -->
		<section class="view cover" id="_cover">
			<div class="page">
				<div class="cover-top">
					<div class="cover-head">
						<div>@bymandychen</div>
						<div>digital diary 2026</div>
					</div>
					<a class="cover-portfolio" href={PORTFOLIO_URL}>go to my portfolio &rarr;</a>
				</div>

				<ul class="cover-cats">
					{
						folders.map((f) => (
							<li>
								{CLICKABLE.has(f.c) ? (
									<a href={`#${f.id}`}>{f.c}</a>
								) : (
									<span>{f.c}</span>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- FOLDER LISTS -->
		{
			folders.map((f) => (
				<section class="view folder" id={f.id} hidden>
					<div class="page">
						<a class="crumb-link" href="#_cover">&larr; return home</a>
						<h1>{f.c}</h1>
						{f.list.length > 0 ? (
							<ul class="cat-list">
								{f.list.map(({ e }) => (
									<li>
										<a href={`#${e.id}`}>{e.data.title ?? e.id}</a>
									</li>
								))}
							</ul>
						) : FOLDER_TEXT[f.c] ? (
							<p class="folder-note">{FOLDER_TEXT[f.c]}</p>
						) : (
							<p class="soon">coming soon</p>
						)}
					</div>
				</section>
			))
		}

		<!-- ENTRY READERS: one horizontal "book" per folder -->
		{
			folders
				.filter((f) => f.list.length > 0)
				.map((f) => (
					<div class="view reader" id={`reader-${f.id}`} hidden>
						{f.list.map(({ e, Content, photos }) => (
							<section class="spread" id={e.id}>
								<article class="page">
									<a class="crumb-link" href={`#${f.id}`}>&larr; {f.c}</a>
									{e.data.title && <h1>{e.data.title}</h1>}
									<Content />
									{photos.length > 0 && (
										<div class="photos">
											{photos.map((img) => (
												<Image src={img} alt="" width={480} />
											))}
										</div>
									)}
								</article>
							</section>
						))}
					</div>
				))
		}

		{
			misc.length > 0 && (
				<div class="view reader" id="reader-misc" hidden>
					{misc.map(({ e, Content, photos }) => (
						<section class="spread" id={e.id}>
							<article class="page">
								<a class="crumb-link" href="#_cover">
									&larr; return home
								</a>
								{e.data.title && <h1>{e.data.title}</h1>}
								<Content />
								{photos.length > 0 && (
									<div class="photos">
										{photos.map((img) => (
											<Image src={img} alt="" width={480} />
										))}
									</div>
								)}
							</article>
						</section>
					))}
				</div>
			)
		}
	</div>

	<button class="nav prev" aria-label="Previous" hidden>&#8249;</button>
	<button class="nav next" aria-label="Next" hidden>&#8250;</button>
</Page>

<script>
	const views = Array.from(document.querySelectorAll<HTMLElement>('.view'));
	const prev = document.querySelector<HTMLButtonElement>('.nav.prev');
	const next = document.querySelector<HTMLButtonElement>('.nav.next');

	let activeReader: HTMLElement | null = null;

	const instantScroll = (container: HTMLElement, el: HTMLElement) => {
		const keep = container.style.scrollBehavior;
		container.style.scrollBehavior = 'auto';
		el.scrollIntoView({ inline: 'start', block: 'nearest' });
		container.style.scrollBehavior = keep;
	};

	const spreadsIn = (r: HTMLElement) =>
		Array.from(r.querySelectorAll<HTMLElement>('.spread'));

	const updateNav = () => {
		if (!activeReader) {
			if (prev) prev.hidden = true;
			if (next) next.hidden = true;
			return;
		}
		const all = spreadsIn(activeReader);
		const i = Math.round(activeReader.scrollLeft / activeReader.clientWidth);
		if (prev) prev.hidden = i <= 0;
		if (next) next.hidden = i >= all.length - 1;
		const id = all[i]?.id;
		if (id) history.replaceState(null, '', '#' + id);
	};

	// show the view for a given hash; entries resolve to their folder's reader
	const route = () => {
		const id = (location.hash || '').replace(/^#/, '') || '_cover';
		let target = document.getElementById(id);
		let entrySpread: HTMLElement | null = null;

		if (target && target.classList.contains('spread')) {
			entrySpread = target;
			target = target.closest('.reader');
		}
		if (!target || !target.classList.contains('view')) {
			target = document.getElementById('_cover');
		}

		views.forEach((v) => {
			v.hidden = v !== target;
		});

		if (target && target.classList.contains('reader')) {
			activeReader = target;
			const first = spreadsIn(target)[0];
			instantScroll(target, entrySpread ?? first);
		} else {
			activeReader = null;
		}
		updateNav();
		window.scrollTo(0, 0);
	};

	const flip = (dir: number) => {
		if (!activeReader) return;
		activeReader.scrollBy({ left: dir * activeReader.clientWidth });
	};

	const goHome = () => {
		if (location.hash) history.pushState(null, '', location.pathname);
		route();
	};

	addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight' || e.key === 'PageDown') {
			if (activeReader) {
				e.preventDefault();
				flip(1);
			}
		} else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
			if (activeReader) {
				e.preventDefault();
				flip(-1);
			}
		} else if (e.key === 'Escape') {
			e.preventDefault();
			goHome();
		}
	});

	next?.addEventListener('click', () => flip(1));
	prev?.addEventListener('click', () => flip(-1));

	// links change the hash; router (via hashchange) swaps the view instantly
	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
		a.addEventListener('click', (ev) => {
			ev.preventDefault();
			const href = a.getAttribute('href')!;
			if (href === location.hash) route();
			else location.hash = href;
		});
	});

	addEventListener('hashchange', route);

	let scrollTimer: number | undefined;
	document.addEventListener(
		'scroll',
		(e) => {
			if (!activeReader || e.target !== activeReader) return;
			clearTimeout(scrollTimer);
			scrollTimer = window.setTimeout(updateNav, 90);
		},
		{ capture: true, passive: true },
	);

	route();
</script>
