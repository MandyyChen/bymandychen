---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const entries = await getCollection('diary');
	return entries.map((e) => ({ params: { slug: e.id } }));
}

// Entries live on the horizontal reader at /#<slug>; keep old links working.
const to = `/#${Astro.params.slug}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${to}`} />
		<link rel="canonical" href={to} />
		<script is:inline set:html={`location.replace(${JSON.stringify(to)})`}></script>
	</head>
	<body></body>
</html>
